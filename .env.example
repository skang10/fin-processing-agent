# Local demo only. Replace values outside the repository example.
DATABASE_URL=postgresql://findoc:findoc@127.0.0.1:5432/findoc
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=findoc
MINIO_SECRET_KEY=findoc-demo-only
MINIO_BUCKET=findoc-artifacts
MAX_SOURCE_BYTES=10000000
OCR_MODE=fake
FINDOC_SYNTHETIC_DEMO=true
# Bounded Case Review Agent: Pi always runs; AGENT_MODEL=fake selects the deterministic offline script.
# AGENT_MODEL=fake replays deterministic scripts offline. A live route needs '<provider>/<model-id>' and AGENT_MODEL_API_KEY.
AGENT_MODEL=fake
# AGENT_MODEL_API_KEY=
PI_OFFLINE=1
