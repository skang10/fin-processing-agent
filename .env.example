# Local demo only. Replace values outside the repository example.
DATABASE_URL=postgresql://findoc:findoc@127.0.0.1:5432/findoc
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=findoc
MINIO_SECRET_KEY=findoc-demo-only
MINIO_BUCKET=findoc-artifacts
MAX_SOURCE_BYTES=10000000
OCR_MODE=fake
# Opt-in real local OCR (assets are installed separately with pnpm ocr:setup):
# OCR_MODE=pdf_inspector
# Docker Compose mounts local `models/` and `native-libs/` read-only; Linux ARM64 container paths:
# OCR_MODEL_DIRECTORY=/app/models/pp-ocrv6-small
# PDFIUM_LIB_PATH=/app/native-libs/ocr-runtime/linux-arm64/lib/libpdfium.so
# ORT_DYLIB_PATH=/app/native-libs/ocr-runtime/linux-arm64/onnxruntime-linux-aarch64-1.27.0/lib/libonnxruntime.so.1.27.0
# NAPI_RS_NATIVE_LIBRARY_PATH=/app/native-libs/ocr-runtime/linux-arm64/pdf-inspector-geometry.node
FINDOC_SYNTHETIC_DEMO=true
# Enables the unlinked developer trace page and internal API only for synthetic demo data.
AGENT_DIAGNOSTICS=false
# Bounded Case Review Agent: Pi always runs; the committed default remains deterministic and offline.
AGENT_MODEL=fake
# Optional deterministic acceptance-script override: auto, standard, or policy_violation.
# AGENT_FAKE_SCRIPT=standard
VLM_MODE=fixture
PI_OFFLINE=1

# Opt-in OpenAI acceptance run. Set these only in your uncommitted local .env file:
# First live-acceptance candidate; this is not yet the final default model.
# AGENT_MODEL=openai/gpt-5.6-terra
# OPENAI_API_KEY=
# VLM_MODE=live
# VLM_MODEL=openai/gpt-5.6-terra
# PI_OFFLINE=0
# Other live providers may use the provider-neutral AGENT_MODEL_API_KEY instead.
# AGENT_MODEL_API_KEY=
# VLM_MODEL_API_KEY=
