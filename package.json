{
  "name": "fin-processing-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -b",
    "check": "pnpm typecheck && pnpm test",
    "dev:api": "pnpm --filter @findoc/api dev",
    "dev:web": "pnpm --filter @findoc/web dev",
    "dev:worker": "pnpm --filter @findoc/worker dev",
    "db:generate": "pnpm --filter @findoc/persistence db:generate",
    "db:migrate": "pnpm --filter @findoc/persistence db:migrate",
    "demo:up": "node scripts/demo-compose.mjs up",
    "demo:load": "node scripts/demo-compose.mjs load",
    "demo:down": "node scripts/demo-compose.mjs down",
    "demo:reset": "node scripts/demo-compose.mjs reset",
    "demo:acceptance": "node scripts/demo-compose.mjs acceptance",
    "dataset:documents": "uv run scripts/generate-golden-documents.py",
    "dataset:generate": "pnpm dataset:documents && node scripts/dataset.mjs generate",
    "dataset:validate": "node scripts/dataset.mjs validate",
    "dataset:inspect": "node scripts/dataset.mjs inspect",
    "dataset:load": "node scripts/load-golden.mjs",
    "dataset:external": "node scripts/dataset.mjs external",
    "dataset:confirm": "node scripts/dataset.mjs confirm",
    "dataset:build": "node scripts/dataset.mjs build",
    "evaluate:offline": "node scripts/evaluate.mjs",
    "evaluate:capture": "node scripts/capture-evaluation.mjs",
    "ocr:setup": "node scripts/ocr-runtime.mjs setup",
    "ocr:verify": "node scripts/ocr-runtime.mjs verify",
    "ocr:smoke": "node scripts/ocr-smoke.mjs",
    "ocr:image-smoke": "node scripts/ocr-image-smoke.mjs",
    "ocr:image-acceptance": "node scripts/image-ocr-acceptance.mjs",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc -b --pretty false"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "sharp": "0.35.4",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
